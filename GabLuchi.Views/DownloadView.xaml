<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.DownloadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:GabLuchi.Views" xmlns:vm="clr-namespace:GabLuchi.ViewModels" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DiffRowTemplate">
        <Button Margin="0,0,0,2" Padding="6,4" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}" Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}" CommandParameter="{Binding}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" CornerRadius="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="12.5" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="#6b7280" Text="{Binding Meta}" />
                  </StackPanel>
                  <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#2a2440" CornerRadius="4" Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#c4b5fd" Text="DLC" />
                  </Border>
                  <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#3a3320" CornerRadius="4" Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#d6b36b" Text="{x:Static res:Strings.Confirm_Shared}" />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#14FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="1040" Margin="8,16,8,32" HorizontalAlignment="Center">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Add_Title}" />
        <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.Add_Subtitle}" />

        <ui:TextBox Margin="0,14,0,0" Padding="12,9" PlaceholderText="{x:Static res:Strings.Add_SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasDetails, Converter={StaticResource InverseBoolToVis}}" />

        <!-- ═══════════════ STOREFRONT ═══════════════ -->
        <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowFeatured, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- spotlight carousel -->
            <Border Name="SpotlightFrame" Height="248" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
              <Grid>
                <Button Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}" CommandParameter="{Binding Spotlight}" ToolTip="{Binding Spotlight.Name}" Visibility="{Binding HasSpotlights, Converter={StaticResource BoolToVis}}">
                  <Image Stretch="UniformToFill" Source="{Binding Spotlight.Image}" />
                </Button>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSpotlights, Converter={StaticResource InverseBoolToVis}}">
                  <ui:SymbolIcon HorizontalAlignment="Center" FontSize="36" Foreground="#4b5563" Symbol="Games24" />
                  <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="#6b7280" Text="STORE FEED" />
                </StackPanel>
                <Border VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="{Binding HasSpotlights, Converter={StaticResource BoolToVis}}">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Offset="0" Color="#00000000" />
                      <GradientStop Offset="1" Color="#C8000000" />
                    </LinearGradientBrush>
                  </Border.Background>
                  <StackPanel Margin="18,30,18,14">
                    <TextBlock FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Spotlight.Name}" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <!-- right rail -->
            <Border Grid.Column="1" Padding="14,12" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="6">
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db" Text="{x:Static res:Strings.Add_Trending}" />
                <ListBox Margin="0,4,0,0" MaxHeight="214" ItemsSource="{Binding TopSellers}" AlternationCount="100" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                      <Setter Property="Background" Value="#00FFFFFF" />
                      <Setter Property="BorderThickness" Value="0" />
                      <Setter Property="Padding" Value="0" />
                      <Setter Property="Margin" Value="0" />
                      <Setter Property="Focusable" Value="False" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,1" Padding="4,4" HorizontalContentAlignment="Stretch" Background="#08FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="{Binding Name}">
                          <Control.Template>
                            <ControlTemplate TargetType="{x:Type Button}">
                              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" CornerRadius="3">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock VerticalAlignment="Center" FontSize="11.5" FontWeight="Bold" Foreground="#6b7280" Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource AltIndexPlusOne}}" />
                                  <Border Grid.Column="1" Width="72" Height="34" CornerRadius="3" ClipToBounds="True">
                                    <Image Stretch="UniformToFill" Source="{Binding Image}" />
                                  </Border>
                                  <TextBlock Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#d1d5db" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                </Grid>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="UIElement.IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Border.Background" Value="#16FFFFFF" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Control.Template>
                        </Button>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
            </Border>
          </Grid>

          <StackPanel Margin="0,18,0,0" Visibility="{Binding HasNewReleases, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db" Text="{x:Static res:Strings.Add_Featured_NewReleases}" />
            <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="FeaturedStrip_PreviewMouseWheel">
              <ItemsControl ItemsSource="{Binding NewReleases}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="190" Margin="0,0,10,0" Padding="0" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SelectFeaturedCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="{Binding Name}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="Bd" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="4">
                            <StackPanel>
                              <Border CornerRadius="3,3,0,0" ClipToBounds="True">
                                <Image Height="89" Stretch="UniformToFill" Source="{Binding Image}" />
                              </Border>
                              <TextBlock Height="32" Margin="8,6,8,6" FontSize="12" Foreground="#d1d5db" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Text="{Binding Name}" />
                            </StackPanel>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="Bd" Property="Border.Background" Value="#1a1d23" />
                              <Setter TargetName="Bd" Property="Border.BorderBrush" Value="#33a78bfa" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </StackPanel>

        <!-- ═══════════════ SEARCH RESULTS ═══════════════ -->
        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsResultsOpen, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db" Text="{Binding ResultsCountText}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock FontSize="11" Foreground="#6b7280" Text="Relevance" />
              <TextBlock Margin="10,0" FontSize="11" Foreground="#374151" Text="·" />
              <TextBlock FontSize="11" Foreground="#6b7280" Text="Name" />
              <TextBlock Margin="10,0" FontSize="11" Foreground="#374151" Text="·" />
              <TextBlock FontSize="11" Foreground="#6b7280" Text="Release" />
            </StackPanel>
          </Grid>
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SearchCards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Padding="12,11" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.SelectResultCommand, ElementName=Root}" CommandParameter="{Binding}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="#1a1d24" BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Width="200" Height="92" CornerRadius="3" ClipToBounds="True">
                            <Grid>
                              <Border Background="#12151a" />
                              <ui:SymbolIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="#4b5563" Symbol="Games24" Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}" />
                              <Image Stretch="UniformToFill" Source="{Binding Cover}" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="#6b7280" Text="{Binding AppId}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Border.Background" Value="#0AFFFFFF" />
                          <Setter TargetName="Bd" Property="Border.BorderBrush" Value="#2ea78bfa" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Margin="0,28,0,0" Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}">
          <ui:SymbolIcon HorizontalAlignment="Center" FontSize="34" Foreground="#4b5563" Symbol="Search24" />
          <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="#9ca3af" Text="{Binding NoResultsText}" />
        </StackPanel>

        <!-- ═══════════════ APP PAGE ═══════════════ -->
        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
          <ui:Button HorizontalAlignment="Left" Padding="10,5" Content="{x:Static res:Strings.Add_Back}" Command="{Binding BackToResultsCommand}" Icon="{ui:SymbolIcon ChevronLeft24}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,14,0">
              <Border Height="240" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid>
                  <Image Stretch="UniformToFill" Source="{Binding Details.HeaderImage}" />
                  <Border VerticalAlignment="Bottom">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#E6000000" />
                      </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="20,40,20,16">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="26" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text="{Binding Details.Name}" />
                        <Border Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="#26a78bfa" BorderBrush="#40a78bfa" BorderThickness="1" CornerRadius="4" Visibility="{Binding Details.IsDlc, Converter={StaticResource BoolToVis}}">
                          <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#a78bfa" Text="DLC" />
                        </Border>
                      </StackPanel>
                      <TextBlock Margin="0,5,0,0" FontSize="12" Foreground="#94a3b8">
                        <Run Text="{Binding Details.AppId, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding GenresText, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Margin="0,12,0,0" Padding="16,13" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="6">
                <StackPanel>
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db" Text="{x:Static res:Strings.Add_About}" />
                  <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="#e5e7eb" TextWrapping="Wrap" Text="{Binding GenresText}" Visibility="{Binding GenresText, Converter={StaticResource NullToCollapsed}}" />
                  <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#94a3b8" Text="{Binding Details.ReleaseDate, StringFormat={x:Static res:Strings.Add_Released}}" Visibility="{Binding Details.ReleaseDate, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- install rail -->
            <Border Grid.Column="1" Padding="16" Background="#16181d" BorderBrush="#1f2329" BorderThickness="1" CornerRadius="6">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Details.Name}" />
                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#6b7280">
                  <Run Text="{Binding Details.AppId, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding GenresText, Mode=OneWay}" />
                </TextBlock>
                <Border Margin="0,12,0,0" Padding="5,1.5" HorizontalAlignment="Left" Background="#22a78bfa">
                  <Border.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="CornerRadius" Value="3" />
                    </Style>
                  </Border.Style>
                  <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#a78bfa" Text="{x:Static res:Strings.Add_FastFetch}" />
                </Border>
                <ui:Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Appearance="Primary" Command="{Binding FetchCommand}" Icon="{ui:SymbolIcon ArrowDownload24}">
                  <ContentControl.Content>
                    <Grid>
                      <TextBlock Text="{x:Static res:Strings.Add_Install}" Visibility="{Binding IsChecking, Converter={StaticResource InverseBoolToVis}}" />
                      <TextBlock Text="{x:Static res:Strings.Add_Checking}" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </ContentControl.Content>
                </ui:Button>
                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#6b7280" TextWrapping="Wrap" Text="{x:Static res:Strings.Add_FastFetch_Hint}" />
                <ProgressBar Margin="0,12,0,0" Height="4" Maximum="100" IsIndeterminate="{Binding ActiveSource.IsProgressIndeterminate}" Value="{Binding ActiveSource.Progress, Mode=OneWay}" Visibility="{Binding HasActiveSource, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,10,0,0" FontSize="12.5" Foreground="#f87171" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
                <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4" Visibility="{Binding HasInstallResult, Converter={StaticResource BoolToVis}}">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type Border}">
                      <Setter Property="Background" Value="#1422c55e" />
                      <Setter Property="BorderBrush" Value="#4022c55e" />
                      <Setter Property="BorderThickness" Value="1" />
                      <Style.Triggers>
                        <DataTrigger Value="True" Binding="{Binding InstallFailed}">
                          <Setter Property="Background" Value="#14f0a868" />
                          <Setter Property="BorderBrush" Value="#40f0a868" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center">
                      <FrameworkElement.Style>
                        <Style TargetType="{x:Type ui:SymbolIcon}">
                          <Setter Property="ui:IconElement.Foreground" Value="#22c55e" />
                          <Setter Property="ui:SymbolIcon.Symbol" Value="CheckmarkCircle24" />
                          <Style.Triggers>
                            <DataTrigger Value="True" Binding="{Binding InstallFailed}">
                              <Setter Property="ui:IconElement.Foreground" Value="#f0a868" />
                              <Setter Property="ui:SymbolIcon.Symbol" Value="Warning24" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </FrameworkElement.Style>
                    </ui:SymbolIcon>
                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" Text="{Binding InstallStatus}" />
                    <ui:Button Grid.Column="2" Content="{x:Static res:Strings.Add_Reveal}" Command="{Binding RevealInstalledCommand}" Icon="{ui:SymbolIcon FolderOpen24}" Visibility="{Binding InstallFailed, Converter={StaticResource InverseBoolToVis}}" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Grid Background="#99000000" Visibility="{Binding IsConfirmingOverwrite, Converter={StaticResource BoolToVis}}">
      <Border Width="460" MaxHeight="560" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1c1c22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock FontSize="17" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding ConfirmTitle}" />
          <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.Confirm_ReviewChanges}" />
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock FontSize="12.5" Foreground="#6b7280" TextWrapping="Wrap" Text="{Binding ConfirmNoChanges}" Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />
              <StackPanel Visibility="{Binding HasDiffAdded, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#34d399" Text="{Binding DiffAdded.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
                <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource DiffRowTemplate}" ItemsSource="{Binding DiffAdded}" />
              </StackPanel>
              <StackPanel Margin="0,10,0,0" Visibility="{Binding HasDiffRemoved, Converter={StaticResource BoolToVis}}">
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#f0a868" Text="{Binding DiffRemoved.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
                <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource DiffRowTemplate}" ItemsSource="{Binding DiffRemoved}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Mode_Cancel}" Command="{Binding CancelOverwriteCommand}" />
            <ui:Button Appearance="Primary" Content="{x:Static res:Strings.Confirm_Replace}" Command="{Binding ConfirmOverwriteCommand}" Icon="{ui:SymbolIcon ArrowDownload24}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
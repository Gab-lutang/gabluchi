<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.FixesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels" xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" xmlns:views="clr-namespace:GabLuchi.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="FilterOptionTemplate">
        <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Root" Margin="8,16,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Fixes_Title}" />
      </StackPanel>
      <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.Manage_Refresh}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}" />
    </Grid>
    <ui:TextBox Grid.Row="1" Margin="0,14,0,0" PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
    <ItemsControl Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding Tags}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Margin="0,0,6,6" Cursor="Hand" Command="{Binding DataContext.SelectTagCommand, ElementName=Root}" CommandParameter="{Binding Id}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Name="Pill" Padding="10,4" Background="#14a78bfa" BorderBrush="#40a78bfa" BorderThickness="1" CornerRadius="6">
                  <TextBlock Name="PillText" FontSize="11.5" FontWeight="SemiBold" Foreground="#a78bfa" Text="{Binding Name}" />
                </Border>
                <ControlTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <Setter TargetName="Pill" Property="Border.Background" Value="#a78bfa" />
                    <Setter TargetName="Pill" Property="Border.BorderBrush" Value="#a78bfa" />
                    <Setter TargetName="PillText" Property="TextBlock.Foreground" Value="#ffffff" />
                  </DataTrigger>
                  <Trigger Property="UIElement.IsMouseOver" Value="True">
                    <Setter TargetName="Pill" Property="Border.Background" Value="#28a78bfa" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="3" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
      <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Fixes_Loading}" />
    </StackPanel>
    <TextBlock Grid.Row="3" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#9ca3af" Text="{Binding EmptyMessage}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
    <vwp:VirtualizingItemsControl Name="GameScroller" Grid.Row="3" Margin="0,14,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Standard" ItemsSource="{Binding Items}" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Width="248" Height="180" Margin="0,0,12,12" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Cursor="Hand" Command="{Binding DataContext.OpenGameCommand, ElementName=Root}" CommandParameter="{Binding}">
            <Control.Template>
              <ControlTemplate TargetType="{x:Type Button}">
                <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="10">
                  <StackPanel>
                    <Border Height="116" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="10,10,0,0">
                      <Image Stretch="UniformToFill" Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" />
                    </Border>
                    <StackPanel Margin="12,8,12,10">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                      <TextBlock Margin="0,3,0,0" FontSize="11.5" Foreground="#6b7280" Text="{Binding FixCountLabel}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </ControlTemplate>
            </Control.Template>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </vwp:VirtualizingItemsControl>
    <Grid Row="4" Margin="0,12,0,2" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
      <Grid HorizontalAlignment="Center" Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Margin="2,0" Padding="8,4" Content="‹" FontSize="14" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" />
        <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Margin="6,0" VerticalAlignment="Center" Foreground="#6b7280" Text="…">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="0" Binding="{Binding}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
                <ui:Button Margin="2,0" Padding="8,4" FontSize="13" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding}">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                      <Style.Triggers>
                        <DataTrigger Value="0" Binding="{Binding}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource EqualityMulti}">
                              <Binding />
                              <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter Property="ui:Button.Appearance" Value="Primary" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </ui:Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button Grid.Column="2" Margin="2,0" Padding="8,4" Content="›" FontSize="14" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
      </Grid>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
        <ComboBox MinWidth="72" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize}" />
      </StackPanel>
    </Grid>
    <Grid Row="0" RowSpan="5" Margin="-8,-16,-16,-8" Background="#80000000" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#00FFFFFF" MouseLeftButtonUp="Scrim_Click" />
      <Border Width="420" HorizontalAlignment="Right" Background="#1c1c22" BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0">
        <Grid Margin="20" DataContext="{Binding SelectedGame}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:Button HorizontalAlignment="Right" Icon="{ui:SymbolIcon Dismiss24}" Click="Close_Click" />
          <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <Border Height="150" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="8">
              <Image Stretch="UniformToFill" Source="{Binding Cover, Converter={StaticResource ImagePathToSource}}" />
            </Border>
            <TextBlock Margin="0,10,0,0" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Name}" />
            <TextBlock FontSize="11.5" Foreground="#6b7280" Text="{Binding AppId, StringFormat=App ID: {0}}" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" DataContext="{Binding DataContext, ElementName=Root}">
            <StackPanel>
              <StackPanel Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsLoadingFixes, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
              </StackPanel>
              <ItemsControl Margin="0,0,0,10" ItemsSource="{Binding FixTags}" Visibility="{Binding HasFixTags, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,0,6,6" Cursor="Hand" Command="{Binding DataContext.SelectFixTagCommand, ElementName=Root}" CommandParameter="{Binding Id}">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                          <Border Name="Pill" Padding="10,4" Background="#14a78bfa" BorderBrush="#40a78bfa" BorderThickness="1" CornerRadius="6">
                            <TextBlock Name="PillText" FontSize="11" FontWeight="SemiBold" Foreground="#a78bfa" Text="{Binding Name}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <DataTrigger Value="True" Binding="{Binding IsSelected}">
                              <Setter TargetName="Pill" Property="Border.Background" Value="#a78bfa" />
                              <Setter TargetName="Pill" Property="Border.BorderBrush" Value="#a78bfa" />
                              <Setter TargetName="PillText" Property="TextBlock.Foreground" Value="#ffffff" />
                            </DataTrigger>
                            <Trigger Property="UIElement.IsMouseOver" Value="True">
                              <Setter TargetName="Pill" Property="Border.Background" Value="#28a78bfa" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Control.Template>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Fixes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                      <StackPanel>
                        <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb" TextWrapping="Wrap" Text="{Binding Title, StringFormat={x:Static res:Strings.Fixes_Build}}" />
                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#6b7280" Text="{Binding DateLabel}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tags}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Margin="0,0,5,5" Padding="6,1" Background="#2a2440" CornerRadius="4">
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#c4b5fd" Text="{Binding Name}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <markdig:MarkdownViewer Margin="0,4,0,0" Markdown="{Binding Description}" Visibility="{Binding Description, Converter={StaticResource NullToCollapsed}}" PreviewMouseWheel="Markdown_PreviewMouseWheel">
                          <FrameworkElement.Resources>
                            <ResourceDictionary>
                              <Style x:Key="{x:Static markdig:Styles.DocumentStyleKey}" TargetType="{x:Type FlowDocument}">
                                <Setter Property="FlowDocument.FontFamily" Value="Segoe UI" />
                                <Setter Property="FlowDocument.FontSize" Value="12.5" />
                                <Setter Property="FlowDocument.Foreground" Value="#c9ced6" />
                                <Setter Property="FlowDocument.PagePadding" Value="0" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.ParagraphStyleKey}" TargetType="{x:Type Paragraph}">
                                <Setter Property="Block.Margin" Value="0,0,0,6" />
                                <Setter Property="Block.LineHeight" Value="18" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.Heading1StyleKey}" TargetType="{x:Type Paragraph}">
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#e5e7eb" />
                                <Setter Property="Block.Margin" Value="0,8,0,4" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.Heading2StyleKey}" TargetType="{x:Type Paragraph}">
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#e5e7eb" />
                                <Setter Property="Block.Margin" Value="0,8,0,3" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.Heading3StyleKey}" TargetType="{x:Type Paragraph}">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="#d1d5db" />
                                <Setter Property="Block.Margin" Value="0,6,0,2" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.HyperlinkStyleKey}" TargetType="{x:Type Hyperlink}">
                                <Setter Property="Foreground" Value="#a78bfa" />
                                <Setter Property="Inline.TextDecorations" Value="{x:Null}" />
                              </Style>
                              <Style x:Key="{x:Static markdig:Styles.CodeStyleKey}" TargetType="{x:Type Run}">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="Foreground" Value="#c4b5fd" />
                              </Style>
                            </ResourceDictionary>
                          </FrameworkElement.Resources>
                        </markdig:MarkdownViewer>
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                          <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Fixes_Manifest}" Command="{Binding DataContext.DownloadManifestCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Document24}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" Visibility="{Binding HasManifest, Converter={StaticResource BoolToVis}}" />
                          <ui:Button Appearance="Primary" Content="{x:Static res:Strings.Fixes_Fix}" Command="{Binding DataContext.DownloadFixCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Wrench24}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <ProgressBar Grid.Row="3" Height="6" Margin="0,10,0,0" Maximum="100" IsIndeterminate="{Binding DataContext.IsProgressIndeterminate, ElementName=Root}" Value="{Binding DataContext.Progress, ElementName=Root}" Visibility="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
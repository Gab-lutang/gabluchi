<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.LicenseGateView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels">
  <Grid Background="#66000000">
    <Border MaxWidth="480" Margin="16" Padding="30,32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1c1c22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14">
      <StackPanel>
        <Image Height="64" Margin="0,0,0,18" HorizontalAlignment="Center" Source="pack://application:,,,/Assets/gabluchi_logo.png" Stretch="Uniform" />
        <TextBlock FontSize="21" FontWeight="Bold" Text="{x:Static res:Strings.Settings_Section_License}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#7c8593" Text="{x:Static res:Strings.Settings_LicenseKey_Hint}" TextWrapping="Wrap" />
        <Border Height="1" Margin="0,20,0,0" Background="#1FFFFFFF" />
        <Border Margin="0,20,0,0" Padding="16,14" Background="#0D8B5CF6" BorderBrush="#338B5CF6" BorderThickness="1" CornerRadius="10" Visibility="{Binding IsGuest, Converter={StaticResource BoolToVis}}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Settings_BrowsingAsGuest}" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#7c8593" Text="Sign in with Discord to activate your license key." TextWrapping="Wrap" />
            </StackPanel>
            <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Appearance="Primary" Content="{x:Static res:Strings.Settings_SignInDiscord}" Command="{Binding SignInCommand}" Icon="{ui:SymbolIcon Person24}" IsEnabled="{Binding NotBusy}" />
          </Grid>
        </Border>
        <StackPanel Margin="0,20,0,0" Orientation="Horizontal" Visibility="{Binding IsGuest, Converter={StaticResource InverseBoolToVis}}">
          <ui:SymbolIcon VerticalAlignment="Center" FontSize="18" Foreground="#34d399" Symbol="CheckmarkCircle24" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{x:Static res:Strings.Onboarding_SignedIn}" />
        </StackPanel>
        <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="{Binding StatusColor}" TextWrapping="Wrap" Text="{Binding StatusLine}" Visibility="{Binding StatusLine, Converter={StaticResource NullToCollapsed}}" />
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:TextBox Grid.Column="0" Margin="0,0,10,0" PlaceholderText="{x:Static res:Strings.Settings_LicenseKeyPlaceholder}" Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NotBusy}" VerticalAlignment="Center" />
          <ui:Button Grid.Column="1" Appearance="Primary" Content="{x:Static res:Strings.Settings_LicenseValidate}" Command="{Binding ActivateCommand}" IsEnabled="{Binding NotBusy}" Icon="{ui:SymbolIcon Key24}" VerticalAlignment="Center" />
        </Grid>
        <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
          <TextBlock FontSize="12" Foreground="#7c8593" Text="{x:Static res:Strings.Settings_LicenseGetKey}" />
          <TextBlock Margin="4,0,0,0" FontSize="12" Foreground="#8B5CF6" Cursor="Hand" Text="{x:Static res:Strings.Settings_LicenseDiscord}" TextDecorations="Underline">
            <TextBlock.InputBindings>
              <MouseBinding Command="{Binding OpenDiscordCommand}" MouseAction="LeftClick" />
            </TextBlock.InputBindings>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

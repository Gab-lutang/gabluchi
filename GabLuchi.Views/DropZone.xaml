<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.DropZone" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels" AllowDrop="True" xmlns:views="clr-namespace:GabLuchi.Views" DragEnter="OnDragEnter" DragLeave="OnDragLeave" DragOver="OnDragOver" Drop="OnDrop">
  <Grid>
    <Border MinHeight="92" Padding="16,14" CornerRadius="10" SnapsToDevicePixels="True">
      <FrameworkElement.Style>
        <Style TargetType="{x:Type Border}">
          <Setter Property="Background" Value="#0AFFFFFF" />
          <Setter Property="BorderBrush" Value="#28FFFFFF" />
          <Setter Property="BorderThickness" Value="1.4" />
          <Style.Triggers>
            <DataTrigger Value="True" Binding="{Binding IsDragOver}">
              <Setter Property="Background" Value="#207c3aed" />
              <Setter Property="BorderBrush" Value="#a78bfa" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </FrameworkElement.Style>
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
        <ui:SymbolIcon VerticalAlignment="Center" FontSize="22" Foreground="#a78bfa" Symbol="ArrowDownload24" />
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb" Text="{x:Static res:Strings.Drop_Title}" />
          <TextBlock Margin="0,2,0,0" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Drop_Hint}" />
          <ui:Button Margin="0,8,0,0" Padding="10,5" HorizontalAlignment="Left" Content="{x:Static res:Strings.Drop_BrowseFiles}" FontSize="11.5" Icon="{ui:SymbolIcon FolderOpen24}" Click="OnBrowseClick" />
          <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding ResultText}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#34d399" />
                <Style.Triggers>
                  <DataTrigger Value="True" Binding="{Binding ResultFailed}">
                    <Setter Property="Foreground" Value="#f0a868" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </TextBlock>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
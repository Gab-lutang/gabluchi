<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.CrackFixView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.CrackFix_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.CrackFix_Subtitle}" />

        <!-- 7-Zip Status -->
        <Border Margin="0,18,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Symbol="Info24" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="7-Zip Status" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#9ca3af">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="Checking..." />
                    <Style.Triggers>
                      <DataTrigger Value="True" Binding="{Binding Is7ZipAvailable}">
                        <Setter Property="Text" Value="7-Zip: Found" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Search + Game Dir -->
        <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.CrackFix_SearchLabel}" />

            <!-- Game Name Search -->
            <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.CrackFix_GameName}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static res:Strings.CrackFix_SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                         Content="{x:Static res:Strings.CrackFix_Search}"
                         Click="Search_Click"
                         Icon="{ui:SymbolIcon Search24}"
                         IsEnabled="{Binding CanSearch}" />
            </Grid>

            <!-- Game Directory -->
            <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.CrackFix_GameDir}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" Text="{Binding GameDir, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="..."
                         Click="BrowseGameDir_Click" Padding="8,4" />
            </Grid>

            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Loading -->
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
        </StackPanel>

        <!-- Download Progress -->
        <StackPanel Margin="0,14,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
          <ProgressBar Height="6" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
          <Grid Margin="0,6,0,0">
            <TextBlock FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
            <ui:Button HorizontalAlignment="Right" Content="Cancel" Icon="{ui:SymbolIcon Dismiss24}"
                       Click="CancelDownload_Click" />
          </Grid>
        </StackPanel>

        <!-- Results -->
        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF"
                      BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb"
                               TextWrapping="Wrap" Text="{Binding Name}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280"
                               Text="{Binding BuildId, StringFormat=Build: {0}}" />
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Fixes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,0,5,5" Padding="6,2" Background="#2a2440" CornerRadius="4">
                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#c4b5fd" Text="{Binding Filename}" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary"
                             Content="{x:Static res:Strings.CrackFix_Download}"
                             Click="DownloadAndApply_Click"
                             CommandParameter="{Binding}"
                             Icon="{ui:SymbolIcon ArrowDownload24}"
                             IsEnabled="{Binding DataContext.CanSearch, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.DlcUnlockerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.DlcUnlocker_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.DlcUnlocker_Subtitle}" />

        <!-- Game Directory + AppId -->
        <Border Margin="0,18,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.DlcUnlocker_GameDir}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" Text="{Binding GameDir, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="..."
                         Click="BrowseGameDir_Click" Padding="8,4" />
            </Grid>

            <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.DlcUnlocker_AppIdLabel}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="e.g. 954820" Text="{Binding AppIdText, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                         Content="{x:Static res:Strings.DlcUnlocker_Detect}"
                         Click="DetectPlatform_Click"
                         Icon="{ui:SymbolIcon Search24}"
                         IsEnabled="{Binding CanDetect}" />
            </Grid>

            <!-- Platform Status -->
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Symbol="Info24" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="{Binding DetectedPlatform}" />
            </Grid>

            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Compatible Unlockers -->
        <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10"
                Visibility="{Binding HasCompatibleUnlockers, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.DlcUnlocker_SelectUnlocker}" />
            <ListBox Margin="0,8,0,0" ItemsSource="{Binding CompatibleUnlockers}" SelectedItem="{Binding SelectedUnlocker}"
                     Background="Transparent" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayName}" Foreground="#e5e7eb" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <!-- DLC IDs -->
        <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.DlcUnlocker_DlcIds}" />
            <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#6b7280" Text="{x:Static res:Strings.DlcUnlocker_DlcIdsNote}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="e.g. 123456, 789012" Text="{Binding DlcIdsText, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                         Content="{x:Static res:Strings.DlcUnlocker_FetchDlcs}"
                         Click="FetchDlcIds_Click"
                         Icon="{ui:SymbolIcon ArrowDownload24}"
                         IsEnabled="{Binding CanFetchDlcs}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Install / Uninstall -->
        <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:Button Grid.Column="0" Appearance="Primary"
                         Content="{x:Static res:Strings.DlcUnlocker_Install}"
                         Click="Install_Click"
                         Icon="{ui:SymbolIcon Checkmark24}"
                         IsEnabled="{Binding CanInstall}" />
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"
                          Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
              </StackPanel>
              <ui:Button Grid.Column="2" Appearance="Danger"
                         Content="{x:Static res:Strings.DlcUnlocker_Uninstall}"
                         Click="Uninstall_Click"
                         Icon="{ui:SymbolIcon Dismiss24}"
                         IsEnabled="{Binding CanUninstall}" />
            </Grid>

            <!-- Installed Status -->
            <Grid Margin="0,10,0,0" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ui:SymbolIcon Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Symbol="CheckmarkCircle24" Foreground="#4ade80" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#4ade80">
                <Run Text="Installed: " />
                <Run Text="{Binding InstalledUnlocker.DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

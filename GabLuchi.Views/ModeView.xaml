<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.ModeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" xmlns:views="clr-namespace:GabLuchi.Views">
  <Grid Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Mode_Title}" />
            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.Mode_Subtitle}" />
          </StackPanel>
          <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.Mode_CheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding NotBusy}" />
        </Grid>
        <ItemsControl Margin="0,18,0,0" ItemsSource="{Binding Cards}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,12" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon VerticalAlignment="Center" Foreground="#a78bfa" Symbol="Wrench24" />
                      <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" />
                      <Border Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="#2022c55e" CornerRadius="4" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#4ade80" Text="{x:Static res:Strings.Mode_Recommended}" />
                      </Border>
                      <Border Margin="10,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="#20f59e0b" CornerRadius="4" Visibility="{Binding IsExperimental, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#fbbf24" Text="{x:Static res:Strings.Mode_Experimental}" />
                      </Border>
                      <Border Margin="6,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="#200ea5e9" CornerRadius="4" Visibility="{Binding SupportsCloudRedirect, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#38bdf8" Text="{x:Static res:Strings.Mode_CloudRedirectSupport}" />
                      </Border>
                      <Border Margin="6,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="#207c3aed" CornerRadius="4" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#c4b5fd" Text="{x:Static res:Strings.Mode_Active}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#7c8593" TextWrapping="Wrap" Text="{Binding Description}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#9ca3af" TextWrapping="Wrap" Text="{Binding StatusText}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <ui:Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DataContext.InstallCommand, ElementName=Root}" CommandParameter="{Binding}" Content="{Binding ButtonText}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
                    <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{x:Static res:Strings.Mode_CloudRedirect_Manage}" Command="{Binding DataContext.ManageCloudRedirectCommand, ElementName=Root}" Icon="{ui:SymbolIcon Cloud24}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" Visibility="{Binding ShowManage, Converter={StaticResource BoolToVis}}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" MaxWidth="760" Margin="8,0,16,16">
      <Border Height="1" Margin="0,0,0,14" Background="#1FFFFFFF" />
      <Border Margin="0,0,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
        <FrameworkElement.Style>
          <Style TargetType="{x:Type Border}">
            <Style.Triggers>
              <DataTrigger Value="False" Binding="{Binding CloudRedirectUnlocked}">
                <Setter Property="UIElement.Opacity" Value="0.55" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </FrameworkElement.Style>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon VerticalAlignment="Center" Foreground="#38bdf8" Symbol="Cloud24" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="CloudRedirect" />
            </StackPanel>
            <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#7c8593" Text="{x:Static res:Strings.Mode_CloudRedirect_AddonDesc}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0" FontSize="12.5" Foreground="#9ca3af" TextWrapping="Wrap" Text="{Binding CloudRedirectStatusText}" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:Button MinWidth="96" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ToggleCloudRedirectCommand}" Content="{Binding CloudRedirectToggleText}" IsEnabled="{Binding CanUseCloudRedirect}" />
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{x:Static res:Strings.Mode_Btn_Update}" Command="{Binding UpdateCloudRedirectCommand}" Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding CanUseCloudRedirect}" Visibility="{Binding ShowCloudRedirectUpdate, Converter={StaticResource BoolToVis}}" />
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="{x:Static res:Strings.Mode_CloudRedirect_Manage}" Command="{Binding ManageCloudRedirectCommand}" Icon="{ui:SymbolIcon Cloud24}" IsEnabled="{Binding CanUseCloudRedirect}" Visibility="{Binding ShowCloudRedirectManage, Converter={StaticResource BoolToVis}}" />
          </StackPanel>
        </Grid>
      </Border>
      <ProgressBar Height="6" Margin="0,2,0,0" Maximum="100" IsIndeterminate="{Binding IsProgressIndeterminate}" Value="{Binding Progress}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
    </StackPanel>
    <Grid Row="0" RowSpan="2" Background="#99000000" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
      <Border MaxWidth="420" Margin="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1c1c22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding ConfirmTitle}" />
          <TextBlock Margin="0,8,0,0" FontSize="12.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Mode_Confirm_Body}" TextWrapping="Wrap" />
          <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Mode_Cancel}" Command="{Binding CancelConfirmCommand}" />
            <ui:Button Appearance="Primary" Content="{x:Static res:Strings.Mode_CloseSteamContinue}" Command="{Binding ConfirmInstallCommand}" Icon="{ui:SymbolIcon Power24}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
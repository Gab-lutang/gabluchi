<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.ConfirmOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels" xmlns:views="clr-namespace:GabLuchi.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DiffRowTemplate">
        <Button Margin="0,0,0,2" Padding="6,4" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}" Command="{Binding DataContext.OpenSteamDbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
          <Control.Template>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" CornerRadius="6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock FontSize="12.5" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="#6b7280" Text="{Binding Meta}" />
                  </StackPanel>
                  <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#2a2440" CornerRadius="4" Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#c4b5fd" Text="DLC" />
                  </Border>
                  <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#3a3320" CornerRadius="4" Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
                    <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#d6b36b" Text="{x:Static res:Strings.Confirm_Shared}" />
                  </Border>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#14FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Control.Template>
        </Button>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#99000000" Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVis}}">
    <Border MaxWidth="460" MaxHeight="560" Margin="8" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1c1c22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding ConfirmTitle}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.Confirm_ReviewChanges}" />
        <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock FontSize="12.5" Foreground="#6b7280" TextWrapping="Wrap" Text="{Binding ConfirmNoChanges}" Visibility="{Binding ConfirmNoChanges, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Visibility="{Binding HasAdded, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#34d399" Text="{Binding Added.Count, StringFormat={x:Static res:Strings.Confirm_Adding}}" />
              <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource DiffRowTemplate}" ItemsSource="{Binding Added}" />
            </StackPanel>
            <StackPanel Margin="0,10,0,0" Visibility="{Binding HasRemoved, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#f0a868" Text="{Binding Removed.Count, StringFormat={x:Static res:Strings.Confirm_Removing}}" />
              <ItemsControl Margin="0,6,0,0" ItemTemplate="{StaticResource DiffRowTemplate}" ItemsSource="{Binding Removed}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Confirm_Skip}" Command="{Binding CancelOverwriteCommand}" />
          <ui:Button Appearance="Primary" Content="{x:Static res:Strings.Confirm_Replace}" Command="{Binding ConfirmOverwriteCommand}" Icon="{ui:SymbolIcon ArrowDownload24}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
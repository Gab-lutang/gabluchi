<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.SmartDlcView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="8,16,16,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.SmartDlc_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.SmartDlc_Subtitle}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
        <ui:Button Margin="0,0,8,0" Appearance="Primary" Content="{x:Static res:Strings.SmartDlc_ScanAll}"
                   Command="{Binding ScanAllCommand}" Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolToVis}}" />
        <ui:Button Content="{x:Static res:Strings.SmartDlc_UnlockAll}"
                   Command="{Binding UnlockAllCommand}" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                   IsEnabled="{Binding HasResults}" />
      </StackPanel>
    </Grid>

    <!-- Summary -->
    <Border Grid.Row="1" Margin="8,12,16,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10"
            Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
      <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SummaryText}" Foreground="#9ca3af" />
    </Border>

    <!-- Progress -->
    <TextBlock Grid.Row="2" Margin="8,10,16,0" FontSize="12" Foreground="#9ca3af" Text="{Binding ProgressText}"
               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

    <!-- Loading ring -->
    <ui:ProgressRing Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Center" Width="40" Height="40" IsIndeterminate="True"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />

    <!-- Results -->
    <ItemsControl Grid.Row="4" Margin="8,12,16,8" ItemsSource="{Binding Results}" VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Margin="0,0,0,8" Padding="16" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <!-- Game name + install button -->
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding GameName}" Foreground="#e5e7eb" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#6b7280" Text="{Binding InstallDir}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                </StackPanel>
                <ui:Button Grid.Column="1" Margin="6,0,0,0" Appearance="Primary" Padding="10,4" VerticalAlignment="Center"
                           Content="{x:Static res:Strings.SmartDlc_Install}"
                           Command="{Binding DataContext.InstallSingleCommand, ElementName=Root}"
                           CommandParameter="{Binding}"
                           IsEnabled="{Binding RecommendedUnlocker, Converter={StaticResource NullToCollapsed}}" />
              </Grid>

              <!-- Platform + unlocker info -->
              <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="6,2" CornerRadius="4" Background="#14ffffff">
                  <TextBlock FontSize="11" Foreground="#9ca3af" Text="{Binding DetectedPlatform, Converter={StaticResource SmartDlcPlatformLabel}}" />
                </Border>
                <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="12" Foreground="#6b7280" VerticalAlignment="Center"
                           Text="{Binding RecommendedUnlocker.DisplayName, Converter={StaticResource SmartDlcUnlockerLabel}}" />
                <Border Grid.Column="2" Padding="6,2" CornerRadius="4" Background="#1422c55e">
                  <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#22c55e"
                             Text="{Binding DlcIds.Count, Converter={StaticResource SmartDlcCountLabel}}" />
                </Border>
              </Grid>

              <!-- Status message -->
              <TextBlock Grid.Row="2" Margin="0,6,0,0" FontSize="12" Foreground="#6b7280" Text="{Binding Message}" TextWrapping="Wrap" />
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.ManageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:vm="clr-namespace:GabLuchi.ViewModels" xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" xmlns:views="clr-namespace:GabLuchi.Views">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="FilterOptionTemplate">
        <TextBlock Text="{Binding Converter={StaticResource FilterOptionDisplay}}" />
      </DataTemplate>
      <Style x:Key="RowButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="-6,0,-6,2" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" CornerRadius="6" Padding="{TemplateBinding Control.Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Border.Background" Value="#14FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="DepotRowTemplate">
        <Button ToolTip="{x:Static res:Strings.Confirm_OpenSteamDb}" Style="{StaticResource RowButtonStyle}" Command="{Binding DataContext.OpenSteamDbCommand, ElementName=Root}" CommandParameter="{Binding}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock FontSize="12.5" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
              <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="#6b7280" Text="{Binding Meta}" />
            </StackPanel>
            <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#2a2440" CornerRadius="4" Visibility="{Binding IsDlc, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#c4b5fd" Text="DLC" />
            </Border>
            <Border Grid.Column="1" Margin="8,1,0,0" Padding="5,1" VerticalAlignment="Top" Background="#3a3320" CornerRadius="4" Visibility="{Binding IsShared, Converter={StaticResource BoolToVis}}">
              <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="#d6b36b" Text="{x:Static res:Strings.Confirm_Shared}" />
            </Border>
          </Grid>
        </Button>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="Root" Margin="8,16,16,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.Manage_Title}" />
      </StackPanel>
      <ui:Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static res:Strings.Manage_Refresh}" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}" />
    </Grid>
    <Grid Row="1" Margin="0,14,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:TextBox PlaceholderText="{x:Static res:Strings.Common_SearchPlaceholder}" Icon="{ui:SymbolIcon Search24}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
        <ui:Button Content="{x:Static res:Strings.Manage_SelectAll}" Command="{Binding SelectAllCommand}" Icon="{ui:SymbolIcon SelectAllOn24}" />
        <ui:Button Margin="8,0,0,0" Content="{x:Static res:Strings.Manage_Filters}" Command="{Binding ToggleFilterPanelCommand}" Icon="{ui:SymbolIcon Filter24}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Margin="0,10,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVis}}">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <WrapPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Type}" />
              <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Genre}" />
              <ComboBox MinWidth="140" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding GenreOptions}" SelectedItem="{Binding SelectedGenre}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Year}" />
              <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Price}" />
              <ComboBox MinWidth="90" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding SelectedPrice}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_Content}" />
              <ComboBox MinWidth="120" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding ContentOptions}" SelectedItem="{Binding SelectedContent}" />
            </StackPanel>
            <StackPanel Margin="0,0,16,8">
              <TextBlock FontSize="11" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_Filter_SortBy}" />
              <ComboBox MinWidth="150" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}" />
            </StackPanel>
          </WrapPanel>
          <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.Manage_ClearFilters}" FontSize="11.5" Command="{Binding ClearFiltersCommand}" Icon="{ui:SymbolIcon Dismiss24}" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding HasPendingDetails, Converter={StaticResource BoolToVis}}">
          <ui:ProgressRing Width="14" Height="14" VerticalAlignment="Center" IsIndeterminate="True" />
          <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{Binding FilterPendingText}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <vwp:VirtualizingItemsControl Name="TileScroller" Grid.Row="3" Margin="0,14,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Standard" ItemsSource="{Binding Items}" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="StartAndEndOnly" StretchItems="False" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Name="TileRoot" Width="248" Height="208" Margin="0,0,12,12" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" Cursor="Hand" CornerRadius="10" Tag="{Binding ElementName=Root, Path=DataContext}" Loaded="Tile_Loaded" MouseLeftButtonUp="Tile_Click">
            <FrameworkElement.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{x:Static res:Strings.Manage_Action_ViewDetails}" Command="{Binding PlacementTarget.Tag.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Info24}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_Update}" Command="{Binding PlacementTarget.Tag.UpdateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowDownload24}" />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_RemoveDrm}" Command="{Binding PlacementTarget.Tag.RemoveDrmCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_OpenStore}" Command="{Binding PlacementTarget.Tag.OpenStorePageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Globe24}" />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_OpenInSteam}" Command="{Binding PlacementTarget.Tag.OpenInSteamCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Open24}" />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_Reveal}" Command="{Binding PlacementTarget.Tag.RevealFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen24}" />
                <MenuItem Header="{x:Static res:Strings.Manage_Action_CopyAppId}" Command="{Binding PlacementTarget.Tag.CopyAppIdCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Copy24}" />
                <Separator />
                <MenuItem Foreground="#f87171" Header="{x:Static res:Strings.Manage_DeleteThisLua}" Command="{Binding PlacementTarget.Tag.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" />
              </ContextMenu>
            </FrameworkElement.ContextMenu>
            <StackPanel>
              <Border Height="116" Background="#11FFFFFF" CornerRadius="10,10,0,0" ClipToBounds="True">
                <Grid>
                  <Image Stretch="UniformToFill" Source="{Binding Cover}" />
                  <ui:Button Margin="6,6,0,0" Padding="6" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{x:Static res:Strings.Manage_Select}" Icon="{ui:SymbolIcon Checkmark24}" Click="ToggleSelect_Click">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                        <Setter Property="UIElement.Opacity" Value="0" />
                        <Setter Property="Background" Value="#cc14161c" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=TileRoot}">
                            <Setter Property="UIElement.Opacity" Value="1" />
                          </DataTrigger>
                          <DataTrigger Value="True" Binding="{Binding IsSelected}">
                            <Setter Property="UIElement.Opacity" Value="1" />
                            <Setter Property="Background" Value="#cc16a34a" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </ui:Button>
                  <ui:Button Margin="0,6,6,0" Padding="6" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#cc1f1417" ToolTip="{x:Static res:Strings.Manage_DeleteThisLua}" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}">
                    <FrameworkElement.Style>
                      <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                        <Setter Property="UIElement.Opacity" Value="0" />
                        <Style.Triggers>
                          <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=TileRoot}">
                            <Setter Property="UIElement.Opacity" Value="1" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                  </ui:Button>
                </Grid>
              </Border>
              <StackPanel Margin="12,10,12,12">
                <TextBlock Height="36" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Text="{Binding Name}" />
                <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="#6b7280" Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#4b5563" TextTrimming="CharacterEllipsis" Text="{Binding AddedReleaseLabel}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </vwp:VirtualizingItemsControl>
    <StackPanel Grid.Row="3" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
      <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
      <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_LoadingGames}" />
    </StackPanel>
    <StackPanel Grid.Row="3" Margin="0,40,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
      <ui:SymbolIcon HorizontalAlignment="Center" FontSize="32" Foreground="#4b5563" Symbol="Games24" />
      <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="#9ca3af" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding EmptyMessage}" />
    </StackPanel>
    <Border Grid.Row="3" Margin="0,0,0,16" Padding="8,8,12,8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#1f1f27" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="12" Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVis}}">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="18" Opacity="0.5" ShadowDepth="2" Color="Black" />
      </UIElement.Effect>
      <StackPanel Orientation="Horizontal">
        <TextBlock Margin="8,0,12,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" Text="{Binding SelectionLabel}" />
        <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Manage_Clear}" Command="{Binding ClearSelectionCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
        <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Manage_CopySelected}" Command="{Binding CopySelectedCommand}" Icon="{ui:SymbolIcon Copy24}" />
        <ui:Button Margin="0,0,8,0" Content="{x:Static res:Strings.Manage_RemoveDrmSelected}" Command="{Binding RemoveDrmSelectedCommand}" Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
        <ui:Button Appearance="Danger" Content="{x:Static res:Strings.Manage_DeleteSelected}" Command="{Binding DeleteSelectedCommand}" Icon="{ui:SymbolIcon Delete24}" />
      </StackPanel>
    </Border>
    <Grid Row="4" Margin="0,12,0,2" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVis}}">
      <Grid HorizontalAlignment="Center" Visibility="{Binding ShowPager, Converter={StaticResource BoolToVis}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:Button Grid.Column="0" Margin="2,0" Padding="8,4" Content="‹" FontSize="14" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanGoPrev}" />
        <ItemsControl Grid.Column="1" HorizontalAlignment="Center" ItemsSource="{Binding PageNumbers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <TextBlock Margin="6,0" VerticalAlignment="Center" Foreground="#6b7280" Text="…">
                  <FrameworkElement.Style>
                    <Style TargetType="{x:Type TextBlock}">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Value="0" Binding="{Binding}">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </TextBlock>
                <ui:Button Margin="2,0" Padding="8,4" FontSize="13" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Content="{Binding}">
                  <FrameworkElement.Style>
                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="{x:Type ui:Button}">
                      <Style.Triggers>
                        <DataTrigger Value="0" Binding="{Binding}">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Value="True">
                          <DataTrigger.Binding>
                            <MultiBinding Converter="{StaticResource EqualityMulti}">
                              <Binding />
                              <Binding Path="DataContext.CurrentPage" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                            </MultiBinding>
                          </DataTrigger.Binding>
                          <Setter Property="ui:Button.Appearance" Value="Primary" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </FrameworkElement.Style>
                </ui:Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button Grid.Column="2" Margin="2,0" Padding="8,4" Content="›" FontSize="14" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}" />
      </Grid>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_ResultsPerPage}" />
        <ComboBox MinWidth="72" ItemTemplate="{StaticResource FilterOptionTemplate}" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize}" />
      </StackPanel>
    </Grid>
    <Grid Row="0" RowSpan="5" Margin="-8,-16,-16,-8" Background="#80000000" Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
      <Border Background="#00FFFFFF" MouseLeftButtonUp="Scrim_Click" />
      <Border Width="380" HorizontalAlignment="Right" Background="#1c1c22" BorderBrush="#22FFFFFF" BorderThickness="1,0,0,0">
        <Grid Margin="20" DataContext="{Binding SelectedTile}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ui:Button Grid.Row="0" HorizontalAlignment="Right" Appearance="Transparent" Command="{Binding DataContext.CloseDetailCommand, ElementName=Root}" Icon="{ui:SymbolIcon Dismiss24}" />
          <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <Border Height="170" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="10">
              <Image Stretch="UniformToFill" Source="{Binding Cover}" />
            </Border>
            <TextBlock Margin="0,12,0,0" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding Name}" />
            <Button Margin="0,4,0,0" HorizontalAlignment="Left" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" ToolTip="{x:Static res:Strings.Manage_CopyAppIdTip}" Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}" CommandParameter="{Binding}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <ContentPresenter />
                </ControlTemplate>
              </Control.Template>
              <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="12" Foreground="#9ca3af" Text="{Binding AppId, StringFormat={x:Static res:Strings.Common_AppId}}" />
                <ui:SymbolIcon Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#6b7280" Symbol="Copy24" />
              </StackPanel>
            </Button>
            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#6b7280" Text="{Binding AddedReleaseLabel}" />
          </StackPanel>
          <ScrollViewer Grid.Row="2" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel DataContext="{Binding DataContext.Detail, ElementName=Root}">
              <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.Manage_LoadingDepotInfo}" />
              </StackPanel>
              <TextBlock FontSize="12" Foreground="#f87171" TextWrapping="Wrap" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource NullToCollapsed}}" />
              <StackPanel Visibility="{Binding HasInLua, Converter={StaticResource BoolToVis}}">
                <Button Padding="0" HorizontalContentAlignment="Left" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.ToggleInLuaCommand, ElementName=Root}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db">
                    <Run Text="{Binding InLuaToggleLabel, Mode=OneWay}" /> <Run Foreground="#6b7280" Text="{Binding InLuaCount, StringFormat=({0}), Mode=OneWay}" /></TextBlock>
                </Button>
                <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource DepotRowTemplate}" ItemsSource="{Binding InLua}" Visibility="{Binding IsInLuaExpanded, Converter={StaticResource BoolToVis}}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                <Button Padding="0" HorizontalContentAlignment="Left" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.ToggleMissingCommand, ElementName=Root}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#f0a868">
                    <Run Text="{Binding MissingToggleLabel, Mode=OneWay}" /> <Run Foreground="#6b7280" Text="{Binding MissingCount, StringFormat=({0}), Mode=OneWay}" /></TextBlock>
                </Button>
                <StackPanel Visibility="{Binding IsMissingExpanded, Converter={StaticResource BoolToVis}}">
                  <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="#6b7280" Text="{x:Static res:Strings.Manage_MissingHint}" TextWrapping="Wrap" />
                  <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource DepotRowTemplate}" ItemsSource="{Binding Missing}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding HasUnknown, Converter={StaticResource BoolToVis}}">
                <Button Padding="0" HorizontalContentAlignment="Left" Background="#00FFFFFF" BorderThickness="0" Cursor="Hand" Command="{Binding DataContext.ToggleUnknownCommand, ElementName=Root}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#9ca3af">
                    <Run Text="{Binding UnknownToggleLabel, Mode=OneWay}" /> <Run Foreground="#6b7280" Text="{Binding UnknownCount, StringFormat=({0}), Mode=OneWay}" /></TextBlock>
                </Button>
                <StackPanel Visibility="{Binding IsUnknownExpanded, Converter={StaticResource BoolToVis}}">
                  <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="#6b7280" Text="{x:Static res:Strings.Manage_UnknownHint}" TextWrapping="Wrap" />
                  <ItemsControl Margin="0,8,0,0" ItemTemplate="{StaticResource DepotRowTemplate}" ItemsSource="{Binding Unknown}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Foreground="#d1d5db" Text="{x:Static res:Strings.Manage_ActionsHeader}" />
            <ProgressBar Height="3" Margin="0,0,0,8" Maximum="100" IsIndeterminate="{Binding DataContext.IsProgressIndeterminate, ElementName=Root}" Value="{Binding DataContext.Progress, ElementName=Root}" Visibility="{Binding DataContext.IsBusy, ElementName=Root, Converter={StaticResource BoolToVis}}" />
            <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Content="{x:Static res:Strings.Manage_Action_Update}" Command="{Binding DataContext.UpdateCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_Action_RemoveDrm}" Command="{Binding DataContext.RemoveDrmCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon WrenchScrewdriver24}" IsEnabled="{Binding DataContext.NotBusy, ElementName=Root}" />
            <UniformGrid Margin="0,8,0,0" Columns="2" Rows="2">
              <ui:Button Margin="0,0,4,4" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_Action_OpenStore}" Command="{Binding DataContext.OpenStorePageCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Globe24}" />
              <ui:Button Margin="4,0,0,4" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_Action_OpenInSteam}" Command="{Binding DataContext.OpenInSteamCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Open24}" />
              <ui:Button Margin="0,4,4,0" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_Action_Reveal}" Command="{Binding DataContext.RevealFileCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon FolderOpen24}" />
              <ui:Button Margin="4,4,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_Action_CopyAppId}" Command="{Binding DataContext.CopyAppIdCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Copy24}" />
            </UniformGrid>
            <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Manage_DeleteThisLua}" Foreground="#f87171" Command="{Binding DataContext.DeleteCommand, ElementName=Root}" CommandParameter="{Binding}" Icon="{ui:SymbolIcon Delete24}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
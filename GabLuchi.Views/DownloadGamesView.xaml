<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.DownloadGamesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.DownloadGames_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.DownloadGames_Subtitle}" />

        <!-- Info Card -->
        <Border Margin="0,18,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" Symbol="Info24" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#9ca3af" TextWrapping="Wrap"
                       Text="{x:Static res:Strings.DownloadGames_Description}" />
          </Grid>
        </Border>

        <!-- Search + Install Dir -->
        <Border Margin="0,12,0,0" Padding="18" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static res:Strings.DownloadGames_SearchLabel}" />

            <!-- Game Name Search -->
            <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.DownloadGames_GameName}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static res:Strings.DownloadGames_SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                         Content="{x:Static res:Strings.DownloadGames_Search}"
                         Click="Search_Click"
                         Icon="{ui:SymbolIcon Search24}"
                         IsEnabled="{Binding CanSearch}" />
            </Grid>

            <!-- Install Directory -->
            <TextBlock Margin="0,12,0,4" FontSize="12" Foreground="#9ca3af" Text="{x:Static res:Strings.DownloadGames_InstallDir}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" Text="{Binding InstallDir, UpdateSourceTrigger=PropertyChanged}" />
              <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Content="..."
                         Click="BrowseInstallDir_Click" Padding="8,4" />
            </Grid>

            <!-- Extract Button -->
            <ui:Button Margin="0,12,0,0" Appearance="Secondary" Width="200" HorizontalAlignment="Left"
                       Content="{x:Static res:Strings.DownloadGames_Extract}"
                       Click="ExtractDownloaded_Click"
                       Icon="{ui:SymbolIcon FolderZip24}" />

            <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Loading -->
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
        </StackPanel>

        <!-- Results -->
        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF"
                      BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                  <!-- Title + Meta -->
                  <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb"
                             TextWrapping="Wrap" Text="{Binding Title}" />
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="11" Foreground="#6b7280" Text="{Binding Version}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Margin="0,0,5,0" Padding="6,2" Background="#1a3a2a" CornerRadius="4">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#4ade80" Text="{Binding FileSize}" />
                      </Border>
                      <Border Padding="6,2" Background="#1a2a3a" CornerRadius="4">
                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#60a5fa" Text="{Binding Genre}" />
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- Mirror Buttons -->
                  <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding DownloadUrls}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Margin="0,0,5,5" Padding="8,4" FontSize="11"
                                Click="OpenMirror_Click" CommandParameter="{Binding}"
                                ToolTip="{Binding}">
                          <Button.Content>
                            <StackPanel Orientation="Horizontal">
                              <ui:SymbolIcon Symbol="ArrowUpRight24" Margin="0,0,4,0" />
                              <TextBlock Text="{Binding Converter={StaticResource UrlToHoster}}" />
                            </StackPanel>
                          </Button.Content>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

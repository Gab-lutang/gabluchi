<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.MultiplayerFixView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.MultiplayerFix_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.MultiplayerFix_Subtitle}" />

        <!-- Search Box -->
        <Border Margin="0,18,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Static res:Strings.MultiplayerFix_SearchLabel}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static res:Strings.MultiplayerFix_SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                         Content="{x:Static res:Strings.MultiplayerFix_Search}"
                         Command="{Binding SearchCmd}"
                         Icon="{ui:SymbolIcon Search24}"
                         IsEnabled="{Binding CanSearch}" />
              <ui:Button Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                         Content="{x:Static res:Strings.MultiplayerFix_OpenOnSite}"
                         Command="{Binding SearchOnSiteCmd}"
                         Icon="{ui:SymbolIcon Globe24}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Loading -->
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
        </StackPanel>

        <!-- Results -->
        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF"
                      BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb"
                               TextWrapping="Wrap" Text="{Binding Title}" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280"
                               Text="{Binding Url}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#9ca3af">
                      <Run Text="Score: " /><Run Text="{Binding Score, StringFormat=F2}" />
                    </TextBlock>
                  </StackPanel>
                  <ui:Button Grid.Column="1" VerticalAlignment="Center"
                             Content="{x:Static res:Strings.MultiplayerFix_Open}"
                             Command="{Binding DataContext.OpenInBrowserCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding}"
                             Icon="{ui:SymbolIcon Globe24}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.MultiplayerFixView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" Margin="8,16,16,8">
        <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.MultiplayerFix_Title}" />
        <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.MultiplayerFix_Subtitle}" />

        <!-- Search Box -->
        <Border Margin="0,18,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Static res:Strings.MultiplayerFix_SearchLabel}" />
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static res:Strings.MultiplayerFix_SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
              <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                         Content="{x:Static res:Strings.MultiplayerFix_Search}"
                         Command="{Binding SearchCmd}"
                         Icon="{ui:SymbolIcon Search24}"
                         IsEnabled="{Binding CanSearch}" />
              <ui:Button Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                         Content="{x:Static res:Strings.MultiplayerFix_OpenOnSite}"
                         Command="{Binding SearchOnSiteCmd}"
                         Icon="{ui:SymbolIcon Globe24}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
          </StackPanel>
        </Border>

        <!-- Download Progress -->
        <Border Margin="0,14,0,0" Padding="14" Background="#0DFFFFFF"
                BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
          <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" Text="{Binding DownloadStatus}" />
            <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                         Value="{Binding DownloadProgress, Mode=OneWay}"
                         Background="#1e293b" Foreground="#06b6d4" />
          </StackPanel>
        </Border>

        <!-- Loading -->
        <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
          <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
        </StackPanel>

        <!-- Results -->
        <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF"
                      BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb"
                                 TextWrapping="Wrap" Text="{Binding GameName}" />
                      <Border Margin="8,2,0,0" Padding="5,1" CornerRadius="4"
                              Background="{Binding Source, Converter={StaticResource SourceToBrushConverter}}">
                        <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White"
                                   Text="{Binding Source}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280"
                               Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#06b6d4">
                      <Run Text="AppID: " /><Run Text="{Binding AppId}" />
                    </TextBlock>
                  </StackPanel>
                  <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary"
                             Content="{x:Static res:Strings.MultiplayerFix_Download}"
                             Command="{Binding DataContext.DownloadAndApplyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             CommandParameter="{Binding}"
                             Icon="{ui:SymbolIcon ArrowDownload24}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Connect with Friend -->
        <Border Margin="0,18,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
          <StackPanel>
            <TextBlock FontSize="15" FontWeight="Bold" Text="Connect with Friend" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#9ca3af" Text="Share a lobby code with your friend to bypass Steam invites" />

            <!-- Host Section -->
            <Border Margin="0,12,0,0" Padding="10" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Share Lobby" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" PlaceholderText="Game name (e.g. Gang Beasts)" Text="{Binding HostGameName, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Port" Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                             Content="Share" Command="{Binding ShareLobbyCmd}"
                             Icon="{ui:SymbolIcon Share24}" IsEnabled="{Binding CanShare}" />
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#06b6d4"
                           Text="{Binding LobbyCode}" Visibility="{Binding HasLobbyCode, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding LobbyStatus}" />
              </StackPanel>
            </Border>

            <!-- Join Section -->
            <Border Margin="0,10,0,0" Padding="10" Background="#08FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8">
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Join Friend's Lobby" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" PlaceholderText="Enter 6-char code" Text="{Binding JoinCodeText, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                             Content="Join" Command="{Binding JoinLobbyCmd}"
                             Icon="{ui:SymbolIcon People24}" IsEnabled="{Binding CanJoin}" />
                </Grid>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Visibility="{Binding HasJoinedGame, Converter={StaticResource BoolToVis}}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#06b6d4" Text="{Binding JoinedGameName}" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text=" — " />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text="{Binding JoinedIp}" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text=":" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text="{Binding JoinedPort}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

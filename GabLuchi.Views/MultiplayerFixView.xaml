<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.MultiplayerFixView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="8,16,16,0">
      <TextBlock FontSize="22" FontWeight="Bold" Text="{x:Static res:Strings.MultiplayerFix_Title}" />
      <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="#9ca3af" Text="{x:Static res:Strings.MultiplayerFix_Subtitle}" />
    </StackPanel>

    <!-- Tabs -->
    <TabControl Grid.Row="1" Margin="8,12,8,8" Background="Transparent" BorderThickness="0">

      <!-- Tab 1: Search -->
      <TabItem Header="  Search Fixes  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" Margin="8,8,16,8">
            <!-- Search Box -->
            <Border Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{x:Static res:Strings.MultiplayerFix_SearchLabel}" />
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" PlaceholderText="{x:Static res:Strings.MultiplayerFix_SearchPlaceholder}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                             Content="{x:Static res:Strings.MultiplayerFix_Search}"
                             Command="{Binding SearchCmd}"
                             Icon="{ui:SymbolIcon Search24}"
                             IsEnabled="{Binding CanSearch}" />
                  <ui:Button Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                             Content="{x:Static res:Strings.MultiplayerFix_OpenOnSite}"
                             Command="{Binding SearchOnSiteCmd}"
                             Icon="{ui:SymbolIcon Globe24}" />
                </Grid>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding StatusMessage}" />
              </StackPanel>
            </Border>

            <!-- Download Progress -->
            <Border Margin="0,14,0,0" Padding="14" Background="#0DFFFFFF"
                    BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" Text="{Binding DownloadStatus}" />
                <ProgressBar Margin="0,8,0,0" Height="6" Minimum="0" Maximum="100"
                             Value="{Binding DownloadProgress, Mode=OneWay}"
                             Background="#1e293b" Foreground="#06b6d4" />
              </StackPanel>
            </Border>

            <!-- Loading -->
            <StackPanel Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
              <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="{x:Static res:Strings.Common_Loading}" />
            </StackPanel>

            <!-- Results -->
            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Results}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,10" Padding="14,12" Background="#0DFFFFFF"
                          BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock FontSize="13.5" FontWeight="SemiBold" Foreground="#e5e7eb"
                                     TextWrapping="Wrap" Text="{Binding GameName}" />
                          <Border Margin="8,2,0,0" Padding="5,1" CornerRadius="4"
                                  Background="{Binding Source, Converter={StaticResource SourceToBrushConverter}}">
                            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="White"
                                       Text="{Binding Source}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280"
                                   Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#06b6d4">
                          <Run Text="AppID: " /><Run Text="{Binding AppId}" />
                        </TextBlock>
                      </StackPanel>
                      <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary"
                                 Content="{x:Static res:Strings.MultiplayerFix_Download}"
                                 Command="{Binding DataContext.DownloadAndApplyCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 CommandParameter="{Binding}"
                                 Icon="{ui:SymbolIcon ArrowDownload24}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 2: Browse Lobbies -->
      <TabItem Header="  Browse Lobbies  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" Margin="8,8,16,8">
            <Border Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" FontSize="15" FontWeight="Bold" Text="Active Lobbies" VerticalAlignment="Center" />
                  <ui:Button Grid.Column="1" Appearance="Primary" Content="Refresh"
                             Command="{Binding RefreshLobbiesCmd}"
                             Icon="{ui:SymbolIcon ArrowSync24}" IsEnabled="{Binding IsBrowsing, Converter={StaticResource InverseBoolConverter}}" />
                </Grid>
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding BrowseStatus}" />

                <!-- Loading -->
                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                            Visibility="{Binding IsBrowsing, Converter={StaticResource BoolToVis}}">
                  <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                  <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#9ca3af" Text="Scanning relay..." />
                </StackPanel>

                <!-- Empty state -->
                <TextBlock Margin="0,20,0,0" FontSize="13" Foreground="#6b7280" HorizontalAlignment="Center"
                           Text="No active lobbies. Host a game or ask a friend to host."
                           Visibility="{Binding ActiveLobbies.Count, Converter={StaticResource ZeroToVis}}" />
              </StackPanel>
            </Border>

            <!-- Lobby List -->
            <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding ActiveLobbies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Padding="14,12" Background="#0DFFFFFF"
                          BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#e5e7eb"
                                   Text="{Binding GameName}" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                          <TextBlock FontSize="12" Foreground="#06b6d4" Text="{Binding HostName}" />
                          <TextBlock FontSize="12" Foreground="#6b7280" Text=" — " />
                          <TextBlock FontSize="12" Foreground="#6b7280" Text="{Binding ConnectText}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#6b7280">
                          <Run Text="AppID: " /><Run Text="{Binding AppId, Mode=OneWay}" />
                          <Run Text="   Age: " /><Run Text="{Binding AgeText}" />
                        </TextBlock>
                      </StackPanel>
                      <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Primary"
                                 Content="Join" Command="{Binding DataContext.JoinFromBrowserCmd, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 CommandParameter="{Binding}" Icon="{ui:SymbolIcon People24}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Tab 3: Connect with Friend -->
      <TabItem Header="  Connect with Friend  ">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="760" Margin="8,8,16,8">
            <!-- Status banner -->
            <Border Margin="0,0,0,14" Padding="12,10" Background="#1A06b6d4" BorderBrush="#06b6d4" BorderThickness="1" CornerRadius="8"
                    Visibility="{Binding HasLobbyCode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock FontSize="14" FontWeight="Bold" Foreground="#06b6d4" Text="Hosting Active" />
                  <TextBlock FontSize="14" Foreground="#6b7280" Text=" — Lobby visible in Browse tab" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#e5e7eb" Text="{Binding LobbyCode}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding LobbyStatus}" />
                <ui:Button Margin="0,8,0,0" Width="120" Appearance="Danger" Content="Stop Hosting"
                           Command="{Binding StopHostingCmd}" Icon="{ui:SymbolIcon Stop24}" />
              </StackPanel>
            </Border>

            <!-- Host Section -->
            <Border Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="Bold" Text="Host a Lobby" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#9ca3af" Text="Share a code with your friend to bypass Steam invites" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" PlaceholderText="Game name" Text="{Binding HostGameName, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="Port" Text="{Binding HostPort, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:TextBox Grid.Column="2" Margin="8,0,0,0" PlaceholderText="Your name" Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                             Content="Host" Command="{Binding ShareLobbyCmd}"
                             Icon="{ui:SymbolIcon Share24}" IsEnabled="{Binding CanShare}" />
                </Grid>
                <TextBlock Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold" Foreground="#06b6d4"
                           Text="{Binding LobbyCode}" Visibility="{Binding HasLobbyCode, Converter={StaticResource BoolToVis}}" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding LobbyStatus}" />
              </StackPanel>
            </Border>

            <!-- Join Section -->
            <Border Margin="0,14,0,0" Padding="14" Background="#0DFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="10">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="Bold" Text="Join Friend's Lobby" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ui:TextBox Grid.Column="0" PlaceholderText="Enter 6-char code" Text="{Binding JoinCodeText, UpdateSourceTrigger=PropertyChanged}" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Appearance="Primary"
                             Content="Join" Command="{Binding JoinLobbyCmd}"
                             Icon="{ui:SymbolIcon People24}" IsEnabled="{Binding CanJoin}" />
                </Grid>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding HasJoinedGame, Converter={StaticResource BoolToVis}}">
                  <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#06b6d4" Text="{Binding JoinedGameName}" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text=" — " />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text="{Binding JoinedIp}" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text=":" />
                  <TextBlock FontSize="13" Foreground="#6b7280" Text="{Binding JoinedPort}" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#9ca3af" Text="{Binding LobbyStatus}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>

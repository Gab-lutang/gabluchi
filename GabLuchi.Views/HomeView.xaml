<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GabLuchi.Views.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:res="clr-namespace:GabLuchi.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:views="clr-namespace:GabLuchi.Views" xmlns:vm="clr-namespace:GabLuchi.ViewModels" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <ResourceDictionary>
      <Style x:Key="HoverRaiseCardButton" TargetType="{x:Type Button}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="Card" Padding="18,16" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="14">
                <Border.RenderTransform>
                  <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Card" Property="Border.Background" Value="#18FFFFFF" />
                  <Setter TargetName="Card" Property="Border.BorderBrush" Value="#33FFFFFF" />
                </Trigger>
                <EventTrigger RoutedEvent="UIElement.MouseEnter">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.16" />
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="UIElement.MouseLeave">
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="HoverScaleWrapper" TargetType="{x:Type Grid}">
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      </Style>
      <Storyboard x:Key="EntranceIn">
        <DoubleAnimation Storyboard.TargetName="HeroCard" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" Duration="0:0:0.34">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="HeroCard" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" Duration="0:0:0.34" />
        <DoubleAnimation Storyboard.TargetName="StatCard1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" BeginTime="0:0:0.08" Duration="0:0:0.3">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="StatCard1" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" BeginTime="0:0:0.08" Duration="0:0:0.3" />
        <DoubleAnimation Storyboard.TargetName="StatCard2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" BeginTime="0:0:0.16" Duration="0:0:0.3">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="StatCard2" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" BeginTime="0:0:0.16" Duration="0:0:0.3" />
        <DoubleAnimation Storyboard.TargetName="StatCard3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="18" To="0" BeginTime="0:0:0.24" Duration="0:0:0.3">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="StatCard3" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" BeginTime="0:0:0.24" Duration="0:0:0.3" />
        <DoubleAnimation Storyboard.TargetName="RecentHeader" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" BeginTime="0:0:0.3" Duration="0:0:0.3">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="RecentHeader" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" BeginTime="0:0:0.3" Duration="0:0:0.3" />
        <DoubleAnimation Storyboard.TargetName="RecentSection" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="16" To="0" BeginTime="0:0:0.38" Duration="0:0:0.32">
          <DoubleAnimation.EasingFunction>
            <CubicEase EasingMode="EaseOut" />
          </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetName="RecentSection" Storyboard.TargetProperty="(UIElement.Opacity)" From="0" To="1" BeginTime="0:0:0.38" Duration="0:0:0.32" />
      </Storyboard>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <ScrollViewer Name="Root" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="880" Margin="8,16,16,24">
        <StackPanel.Triggers>
          <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntranceIn}" />
          </EventTrigger>
        </StackPanel.Triggers>
        <Border Name="HeroCard" Background="#18FFFFFF" BorderBrush="#33A78BFA" BorderThickness="1" CornerRadius="18" RenderTransformOrigin="0.5,0.5" Opacity="0">
          <Border.RenderTransform>
            <TranslateTransform Y="16" />
          </Border.RenderTransform>
          <Border.Effect>
            <DropShadowEffect BlurRadius="28" Opacity="0.35" ShadowDepth="2" Color="#7c3aed" />
          </Border.Effect>
          <Grid>
            <Image Margin="0,0,18,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="160" Opacity="0.14" Source="pack://application:,,,/Assets/gabluchi_logo.png" Stretch="Uniform" />
            <Grid Margin="26,24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Image Height="26" Source="pack://application:,,,/Assets/gabluchi_logo.png" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#a78bfa" Text="GABLUCHI" />
                </StackPanel>
                <TextBlock Margin="0,6,0,0" FontSize="26" FontWeight="Bold" Text="{x:Static res:Strings.Home_Welcome}" />
                <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                  <TextBlock FontSize="44" FontWeight="Bold" Foreground="#a78bfa" Text="{Binding GameCount}" />
                  <TextBlock Margin="10,0,0,8" VerticalAlignment="Bottom" FontSize="14" Foreground="#9ca3af" Text="{x:Static res:Strings.Home_GamesOnBoard}" />
                </StackPanel>
                <WrapPanel Margin="0,20,0,0">
                  <Border Padding="10,5" VerticalAlignment="Center" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="999" ToolTip="{Binding SteamStatus}">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding SteamChipColor}" />
                      <TextBlock Margin="7,0,0,0" FontSize="11.5" Foreground="#d1d5db" Text="{Binding SteamChipText}" />
                    </StackPanel>
                  </Border>
                  <Border Margin="8,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#a78bfa" />
                      <TextBlock Margin="7,0,0,0" FontSize="11.5" Foreground="#d1d5db" TextTrimming="CharacterEllipsis" Text="{Binding ModeStatus}" />
                    </StackPanel>
                  </Border>
                  <Border Margin="8,0,0,0" Padding="10,5" VerticalAlignment="Center" Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="999">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="#6b7280" />
                      <TextBlock Margin="7,0,0,0" FontSize="11.5" Foreground="#d1d5db" Text="{Binding AccountStatus}" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                <Grid Style="{StaticResource HoverScaleWrapper}">
                  <Grid.RenderTransform>
                    <ScaleTransform x:Name="Cta1Scale" ScaleX="1" ScaleY="1" />
                  </Grid.RenderTransform>
                  <Grid.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta1Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.14" />
                          <DoubleAnimation Storyboard.TargetName="Cta1Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.14" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta1Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                          <DoubleAnimation Storyboard.TargetName="Cta1Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Grid.Triggers>
                  <ui:Button MinWidth="150" HorizontalAlignment="Stretch" Appearance="Primary" Content="{x:Static res:Strings.Nav_Add}" Command="{Binding OpenAddCommand}" Icon="{ui:SymbolIcon Add24}" />
                </Grid>
                <Grid Margin="0,10,0,0" Style="{StaticResource HoverScaleWrapper}">
                  <Grid.RenderTransform>
                    <ScaleTransform x:Name="Cta2Scale" ScaleX="1" ScaleY="1" />
                  </Grid.RenderTransform>
                  <Grid.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta2Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.14" />
                          <DoubleAnimation Storyboard.TargetName="Cta2Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.14" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta2Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                          <DoubleAnimation Storyboard.TargetName="Cta2Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Grid.Triggers>
                  <ui:Button MinWidth="150" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Home_ManageLibrary}" Command="{Binding OpenManageCommand}" Icon="{ui:SymbolIcon Games24}" />
                </Grid>
                <Grid Margin="0,10,0,0" Style="{StaticResource HoverScaleWrapper}" Visibility="{Binding AccountShowButton, Converter={StaticResource BoolToVis}}">
                  <Grid.RenderTransform>
                    <ScaleTransform x:Name="Cta3Scale" ScaleX="1" ScaleY="1" />
                  </Grid.RenderTransform>
                  <Grid.Triggers>
                    <EventTrigger RoutedEvent="UIElement.MouseEnter">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta3Scale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.14" />
                          <DoubleAnimation Storyboard.TargetName="Cta3Scale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.14" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.MouseLeave">
                      <BeginStoryboard>
                        <Storyboard>
                          <DoubleAnimation Storyboard.TargetName="Cta3Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18" />
                          <DoubleAnimation Storyboard.TargetName="Cta3Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                      </BeginStoryboard>
                    </EventTrigger>
                  </Grid.Triggers>
                  <ui:Button MinWidth="150" HorizontalAlignment="Stretch" Content="{x:Static res:Strings.Nav_SignInDiscord}" Command="{Binding SignInCommand}" Icon="{ui:SymbolIcon Person24}" />
                </Grid>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <UniformGrid Name="StatRow" Margin="0,14,0,0" Columns="3" Rows="1">
          <Button Name="StatCard1" Margin="0,0,6,0" Style="{StaticResource HoverRaiseCardButton}" Command="{Binding OpenManageCommand}" Opacity="0">
            <Button.RenderTransform>
              <TranslateTransform Y="18" />
            </Button.RenderTransform>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="#a78bfa" Symbol="Games24" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Home_LuasOnBoard}" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" FontSize="28" FontWeight="Bold" Foreground="#e5e7eb" Text="{Binding GameCount}" />
            </StackPanel>
          </Button>
          <Button Name="StatCard2" Margin="3,0" Style="{StaticResource HoverRaiseCardButton}" Command="{Binding OpenModeCommand}" Opacity="0">
            <Button.RenderTransform>
              <TranslateTransform Y="18" />
            </Button.RenderTransform>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="#a78bfa" Symbol="Options24" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Nav_Mode}" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Foreground="#e5e7eb" TextTrimming="CharacterEllipsis" Text="{Binding ModeStatus}" />
            </StackPanel>
          </Button>
          <Button Name="StatCard3" Margin="6,0,0,0" Style="{StaticResource HoverRaiseCardButton}" Command="{Binding OpenPluginCommand}" Opacity="0">
            <Button.RenderTransform>
              <TranslateTransform Y="18" />
            </Button.RenderTransform>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="16" Foreground="#a78bfa" Symbol="PuzzlePiece24" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="#9ca3af" Text="{x:Static res:Strings.Home_PluginStatus}" />
              </StackPanel>
              <TextBlock Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{Binding PluginStatusColor}" TextTrimming="CharacterEllipsis" Text="{Binding PluginStatusText}" />
              <ui:Button Margin="0,10,0,0" Padding="10,4" HorizontalAlignment="Left" Appearance="Primary" Content="{x:Static res:Strings.Plugin_Btn_Install}" Command="{Binding InstallPluginCommand}" IsEnabled="{Binding NotInstallingPlugin}" Visibility="{Binding ShowPluginInstall, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <views:DropZone Margin="0,14,0,0" DataContext="{Binding Drop}" />
        <Grid Name="RecentHeader" Margin="0,22,0,0" Opacity="0">
          <Grid.RenderTransform>
            <TranslateTransform Y="14" />
          </Grid.RenderTransform>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#6b7280" Text="{x:Static res:Strings.Home_LastAdded}" />
            <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static res:Strings.Home_RecentlyAdded}" />
          </StackPanel>
          <ui:Button Grid.Column="1" VerticalAlignment="Center" Appearance="Transparent" Content="{x:Static res:Strings.Home_ViewAll}" Command="{Binding OpenManageCommand}" Icon="{ui:SymbolIcon ChevronRight24}" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}" />
        </Grid>
        <StackPanel Name="RecentSection" Margin="0,12,0,0" Opacity="0" Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
          <StackPanel.RenderTransform>
            <TranslateTransform Y="16" />
          </StackPanel.RenderTransform>
          <ItemsControl ItemsSource="{Binding Recent}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,12,12" Padding="0" Cursor="Hand" ToolTip="{x:Static res:Strings.Home_ViewDetails}" Command="{Binding DataContext.OpenGameCommand, ElementName=Root}" CommandParameter="{Binding}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                      <Border Name="Card" Width="176" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="12">
                        <Border.RenderTransform>
                          <TranslateTransform x:Name="Raise" X="0" Y="0" />
                        </Border.RenderTransform>
                        <StackPanel>
                          <Border Height="88" Background="#11FFFFFF" ClipToBounds="True" CornerRadius="12,12,0,0">
                            <Image Stretch="UniformToFill" Source="{Binding Cover}" />
                          </Border>
                          <TextBlock Margin="11,9,11,11" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        </StackPanel>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <Setter TargetName="Card" Property="Border.Background" Value="#18FFFFFF" />
                          <Setter TargetName="Card" Property="Border.BorderBrush" Value="#55A78BFA" />
                        </Trigger>
                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Y" To="-3" Duration="0:0:0.14" />
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                          <BeginStoryboard>
                            <Storyboard>
                              <DoubleAnimation Storyboard.TargetName="Raise" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18" />
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <views:ConfirmOverlay DataContext="{Binding Drop}" />
  </Grid>
</UserControl>
